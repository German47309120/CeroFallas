rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function activeUser() {
      return signedIn() && ownProfile().status == 'active';
    }

    function hasPermission(permission) {
      return activeUser() && permission in ownProfile().permissions;
    }

    function privilegedMaintainer() {
      return activeUser() && ownProfile().roleId in ['administrator', 'support'];
    }

    function operationalShiftAt(moment) {
      return moment.hours() >= 12 ? 'shift-1' : 'shift-2';
    }

    function executionAfter(executionId) {
      return getAfter(/databases/$(database)/documents/preventiveExecutions/$(executionId));
    }

    function planAfter(planId) {
      return getAfter(/databases/$(database)/documents/preventivePlans/$(planId));
    }

    match /users/{userId} {
      allow read: if (signedIn() && request.auth.uid == userId) || hasPermission('users.read');
      allow write: if false;
    }

    match /equipment/{equipmentId} {
      allow read: if hasPermission('equipment.read');
      allow create: if hasPermission('equipment.manage')
        && request.resource.data.keys().hasAll(['code', 'name', 'type', 'areaId', 'status', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
        && request.resource.data.keys().hasOnly(['code', 'name', 'type', 'areaId', 'status', 'criticality', 'brand', 'model', 'serialNumber', 'notes', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
        && request.resource.data.code is string
        && request.resource.data.code.size() > 0
        && request.resource.data.code.matches('^[A-Z0-9][A-Z0-9._-]{0,39}$')
        && equipmentId == request.resource.data.code
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.type is string
        && request.resource.data.type.size() > 0
        && request.resource.data.status in ['active', 'inactive', 'out_of_service']
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if hasPermission('equipment.manage') && privilegedMaintainer()
        && request.resource.data.keys().hasAll(['code', 'name', 'type', 'areaId', 'status', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
        && request.resource.data.keys().hasOnly(['code', 'name', 'type', 'areaId', 'status', 'criticality', 'brand', 'model', 'serialNumber', 'notes', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
        && request.resource.data.code == resource.data.code
        && request.resource.data.code == equipmentId
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.type is string
        && request.resource.data.type.size() > 0
        && request.resource.data.status in ['active', 'inactive', 'out_of_service']
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    match /audit/{auditId} {
      allow read: if hasPermission('audit.read');
      allow create: if hasPermission('audit.write')
        && request.resource.data.actorId == request.auth.uid
        && request.resource.data.occurredAt == request.time;
      allow update, delete: if false;
    }

    match /correctives/{correctiveId} {
      allow read: if hasPermission('corrective.read');
      allow create: if hasPermission('corrective.create')
        && request.resource.data.keys().hasAll(['eventDate', 'startedAt', 'endedAt', 'durationMinutes', 'areaId', 'areaSnapshot', 'equipmentId', 'equipmentSnapshot', 'technicianIds', 'reportedSymptom', 'workPerformed', 'status', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
        && request.resource.data.status == 'in_progress'
        && request.resource.data.timeSource == 'server'
        && request.resource.data.eventDate == null
        && request.resource.data.startedAt == request.time
        && request.resource.data.endedAt == null
        && request.resource.data.durationMinutes == null
        && request.resource.data.createdBy == request.auth.uid
        && request.auth.uid in request.resource.data.technicianIds
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if (hasPermission('corrective.create')
        && resource.data.status == 'in_progress'
        && resource.data.createdBy == request.auth.uid
        && request.resource.data.status == 'completed'
        && request.resource.data.timeSource == 'server'
        && request.resource.data.startedAt == resource.data.startedAt
        && request.resource.data.endedAt == request.time
        && request.resource.data.durationMinutes == null
        && request.resource.data.areaId == resource.data.areaId
        && request.resource.data.areaSnapshot == resource.data.areaSnapshot
        && request.resource.data.equipmentId == resource.data.equipmentId
        && request.resource.data.equipmentSnapshot == resource.data.equipmentSnapshot
        && request.resource.data.workPerformed is string
        && request.resource.data.workPerformed.size() > 0
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.technicianIds == resource.data.technicianIds
        && request.resource.data.areaId == resource.data.areaId
        && request.resource.data.equipmentId == resource.data.equipmentId
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time
        && request.resource.data.auditId is string
        && correctiveCompletionAudit(request.resource.data, correctiveId))
        || (hasPermission('corrective.manage') && privilegedMaintainer()
          && resource.data.status in ['draft', 'completed']
          && request.resource.data.status in ['draft', 'completed', 'voided']
          && request.resource.data.startedAt == resource.data.startedAt
          && request.resource.data.endedAt == resource.data.endedAt
          && request.resource.data.durationMinutes == resource.data.durationMinutes
          && request.resource.data.eventDate == resource.data.eventDate
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.technicianIds == resource.data.technicianIds
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.updatedAt == request.time
          && (request.resource.data.status != 'voided' || (request.resource.data.voidReason is string && request.resource.data.voidReason.size() > 0)));
      allow delete: if false;
    }

    match /preventivePlans/{planId} {
      allow read: if hasPermission('preventive.read');
      allow create: if hasPermission('preventive.plan')
        && request.resource.data.status == 'active'
        && request.resource.data.estimatedFrequency == true
        && request.resource.data.activityName is string
        && request.resource.data.activityName.size() > 0
        && request.resource.data.frequencyType in ['calendar', 'hours', 'condition']
        && (request.resource.data.frequencyType == 'condition' || (request.resource.data.frequencyValue is number && request.resource.data.frequencyValue > 0))
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if (hasPermission('preventive.manage') && privilegedMaintainer()
          && request.resource.data.status in ['active', 'paused', 'completed', 'voided']
          && request.resource.data.estimatedFrequency == true
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.updatedAt == request.time
          && (request.resource.data.status != 'voided' || (request.resource.data.voidReason is string && request.resource.data.voidReason.size() > 0)))
        || (hasPermission('preventive.execute')
          && resource.data.status == 'active'
          && resource.data.frequencyType == 'calendar'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nextDueAt', 'lastExecutedAt', 'lastExecutionId', 'updatedAt', 'updatedBy'])
          && request.resource.data.lastExecutionId is string
          && request.resource.data.nextDueAt is timestamp
          && request.resource.data.lastExecutedAt is timestamp
          && request.resource.data.nextDueAt >= resource.data.nextDueAt
          && request.resource.data.nextDueAt > request.resource.data.lastExecutedAt
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.updatedAt == request.time
          && executionAfter(request.resource.data.lastExecutionId).data.planId == planId
          && executionAfter(request.resource.data.lastExecutionId).data.equipmentId == resource.data.equipmentId
          && executionAfter(request.resource.data.lastExecutionId).data.createdBy == request.auth.uid
          && executionAfter(request.resource.data.lastExecutionId).data.startedAt == request.resource.data.lastExecutedAt
          && executionAfter(request.resource.data.lastExecutionId).data.rescheduleStatus == 'automatic'
          && executionAfter(request.resource.data.lastExecutionId).data.nextDueAtAfterExecution == request.resource.data.nextDueAt);
      allow delete: if false;
    }

    function preventiveExecutionAudit(data, executionId) {
      let audit = getAfter(/databases/$(database)/documents/audit/$(data.auditId)).data;
      return audit.actorId == request.auth.uid && audit.occurredAt == request.time
        && audit.entityType == 'preventiveExecution' && audit.entityId == executionId;
    }

    function correctiveCompletionAudit(data, correctiveId) {
      let audit = getAfter(/databases/$(database)/documents/audit/$(data.auditId)).data;
      return audit.actorId == request.auth.uid && audit.occurredAt == request.time
        && audit.entityType == 'corrective' && audit.entityId == correctiveId;
    }

    match /preventiveExecutions/{executionId} {
      allow read: if hasPermission('preventive.read');
      allow create: if hasPermission('preventive.execute')
        && request.resource.data.status == 'in_progress'
        && request.resource.data.timeSource == 'server'
        && request.resource.data.startedAt == request.time
        && request.resource.data.endedAt == null
        && request.resource.data.durationMinutes == null
        && request.resource.data.complianceStatus == 'pending'
        && request.resource.data.rescheduleStatus == 'pending'
        && request.resource.data.nextDueAtAfterExecution == null
        && request.resource.data.createdBy == request.auth.uid
        && request.auth.uid in request.resource.data.technicianIds
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if (hasPermission('preventive.execute')
          && resource.data.status == 'in_progress'
          && resource.data.createdBy == request.auth.uid
          && request.resource.data.status == 'completed'
          && request.resource.data.timeSource == 'server'
          && request.resource.data.startedAt == resource.data.startedAt
          && request.resource.data.endedAt == request.time
          && request.resource.data.durationMinutes == null
          && request.resource.data.planId == resource.data.planId
          && request.resource.data.equipmentId == resource.data.equipmentId
          && request.resource.data.equipmentSnapshot == resource.data.equipmentSnapshot
          && request.resource.data.scheduledAt == resource.data.scheduledAt
          && request.resource.data.activityPerformed is string
          && request.resource.data.activityPerformed.size() > 0
          && request.resource.data.complianceStatus in ['on_time', 'late', 'unscheduled']
          && request.resource.data.rescheduleStatus in ['automatic', 'manual_required', 'not_applicable']
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.technicianIds == resource.data.technicianIds
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.updatedAt == request.time
          && request.resource.data.auditId is string
          && preventiveExecutionAudit(request.resource.data, executionId)
          && ((request.resource.data.planId == null
              && request.resource.data.rescheduleStatus == 'not_applicable'
              && request.resource.data.nextDueAtAfterExecution == null)
            || (request.resource.data.planId is string
              && planAfter(request.resource.data.planId).data.status == 'active'
              && planAfter(request.resource.data.planId).data.equipmentId == request.resource.data.equipmentId
              && ((request.resource.data.rescheduleStatus == 'automatic'
                && planAfter(request.resource.data.planId).data.frequencyType == 'calendar'
                && request.resource.data.nextDueAtAfterExecution is timestamp
                && planAfter(request.resource.data.planId).data.lastExecutionId == executionId
                && planAfter(request.resource.data.planId).data.nextDueAt == request.resource.data.nextDueAtAfterExecution)
              || (request.resource.data.rescheduleStatus == 'manual_required'
                && planAfter(request.resource.data.planId).data.frequencyType in ['hours', 'condition']
                && request.resource.data.nextDueAtAfterExecution == null)))))
        || (hasPermission('preventive.manage') && privilegedMaintainer()
        && resource.data.status == 'completed'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'voidReason', 'updatedAt', 'updatedBy', 'auditId'])
        && request.resource.data.status == 'voided'
        && request.resource.data.voidReason is string
        && request.resource.data.voidReason.size() >= 10
        && request.resource.data.voidReason.size() <= 500
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.technicianIds == resource.data.technicianIds
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time
        && request.resource.data.auditId is string
        && preventiveExecutionAudit(request.resource.data, executionId));
      allow delete: if false;
    }

    function inspectionAudit(data, inspectionId) {
      let audit = getAfter(/databases/$(database)/documents/audit/$(data.auditId)).data;
      return audit.actorId == request.auth.uid && audit.occurredAt == request.time
        && audit.entityType == 'forkliftInspection' && audit.entityId == inspectionId;
    }

    match /forkliftInspections/{inspectionId} {
      allow read: if hasPermission('forklift.read');
      allow create: if hasPermission('forklift.inspect')
        && request.resource.data.templateId == 'forklift-daily-v1'
        && request.resource.data.templateVersion == 1
        && request.resource.data.shiftId in ['shift-1', 'shift-2']
        && request.resource.data.hourMeter is number
        && request.resource.data.hourMeter >= 0
        && request.resource.data.answers is list
        && request.resource.data.answers.size() == 25
        && request.resource.data.criticalFailures is int
        && request.resource.data.criticalFailures >= 0
        && request.resource.data.overallResult in ['fit', 'attention_required', 'out_of_service']
        && ((request.resource.data.criticalFailures > 0 && request.resource.data.overallResult == 'out_of_service')
          || (request.resource.data.criticalFailures == 0 && request.resource.data.overallResult in ['fit', 'attention_required']))
        && request.resource.data.status == 'completed'
        && request.resource.data.operatorId == request.auth.uid
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.inspectedAt == request.time
        && request.resource.data.shiftId == operationalShiftAt(request.time)
        && request.resource.data.createdAt == request.time;
      allow update: if hasPermission('forklift.manage') && privilegedMaintainer()
        && resource.data.status == 'completed'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'voidReason', 'updatedAt', 'updatedBy', 'auditId'])
        && request.resource.data.status == 'voided'
        && request.resource.data.voidReason is string
        && request.resource.data.voidReason.size() >= 10
        && request.resource.data.voidReason.size() <= 500
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.operatorId == resource.data.operatorId
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time
        && request.resource.data.auditId is string
        && inspectionAudit(request.resource.data, inspectionId);
      allow delete: if false;
    }

    function incidentAudit(data, incidentId) {
      let audit = getAfter(/databases/$(database)/documents/audit/$(data.auditId)).data;
      return audit.actorId == request.auth.uid && audit.occurredAt == request.time
        && audit.entityType == 'incident' && audit.entityId == incidentId;
    }

    match /incidents/{incidentId} {
      allow read: if hasPermission('incident.read');
      allow create: if hasPermission('incident.create')
        && request.resource.data.keys().hasOnly(['areaId', 'areaName', 'equipmentId', 'equipmentSnapshot', 'description', 'priority', 'status', 'reporterId', 'createdBy', 'createdAt', 'updatedBy', 'updatedAt', 'linkedCorrectiveId', 'followUp', 'auditId'])
        && request.resource.data.areaId in ['linea-1', 'linea-2', 'linea-3', 'linea-4', 'abastecimiento', 'mantenimiento', 'servicios-generales']
        && request.resource.data.description is string
        && request.resource.data.description.size() >= 10 && request.resource.data.description.size() <= 1500
        && request.resource.data.priority in ['low', 'medium', 'high', 'critical']
        && request.resource.data.status == 'reported'
        && request.resource.data.linkedCorrectiveId == null && request.resource.data.followUp == ''
        && request.resource.data.areaName is string && request.resource.data.areaName.size() > 0 && request.resource.data.areaName.size() <= 80
        && ((request.resource.data.equipmentId == null && request.resource.data.equipmentSnapshot == null) || (get(/databases/$(database)/documents/equipment/$(request.resource.data.equipmentId)).data.status == 'active'
          && get(/databases/$(database)/documents/equipment/$(request.resource.data.equipmentId)).data.areaId == request.resource.data.areaId
          && request.resource.data.equipmentSnapshot.code == get(/databases/$(database)/documents/equipment/$(request.resource.data.equipmentId)).data.code
          && request.resource.data.equipmentSnapshot.name == get(/databases/$(database)/documents/equipment/$(request.resource.data.equipmentId)).data.name))
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.createdBy == request.auth.uid && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time
        && incidentAudit(request.resource.data, incidentId);
      allow update: if hasPermission('incident.manage') && ownProfile().roleId in ['administrator', 'support']
        && resource.data.status != 'voided'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'followUp', 'linkedCorrectiveId', 'updatedAt', 'updatedBy', 'auditId'])
        && request.resource.data.status in ['reported', 'acknowledged', 'in_progress', 'resolved', 'voided']
        && request.resource.data.followUp is string && request.resource.data.followUp.size() > 0 && request.resource.data.followUp.size() <= 1000
        && (request.resource.data.linkedCorrectiveId == null || (get(/databases/$(database)/documents/correctives/$(request.resource.data.linkedCorrectiveId)).data.status != 'voided'
          && get(/databases/$(database)/documents/correctives/$(request.resource.data.linkedCorrectiveId)).data.areaId == resource.data.areaId
          && (resource.data.equipmentId == null || get(/databases/$(database)/documents/correctives/$(request.resource.data.linkedCorrectiveId)).data.equipmentId == resource.data.equipmentId)))
        && request.resource.data.updatedBy == request.auth.uid && request.resource.data.updatedAt == request.time
        && request.resource.data.auditId != resource.data.auditId && incidentAudit(request.resource.data, incidentId);
      allow delete: if false;
    }

    match /stock/{stockId} {
      allow read: if hasPermission('stock.read');
      allow write: if false;
    }

    match /integrationStatus/{integrationId} {
      allow read: if integrationId == 'sap-stock' && hasPermission('stock.read');
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
