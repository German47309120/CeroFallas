# Copiar como .local/sap-stock.env. Nunca completar ni versionar esta plantilla.
SAP_SQL_SERVER=
SAP_SQL_PORT=1433
SAP_SQL_DATABASE=
SAP_SQL_USER=
SAP_SQL_PASSWORD=
SAP_SQL_ENCRYPT=true
SAP_SQL_TRUST_SERVER_CERTIFICATE=false
SAP_SQL_CONNECTION_TIMEOUT_MS=15000
SAP_SQL_REQUEST_TIMEOUT_MS=30000
SAP_STOCK_QUERY_PATH=.local/sap-stock-query.sql

# Solo se requieren al publicar en la base central.
SAP_FIREBASE_PROJECT_ID=cerofallas-pg2-german-2026
FIREBASE_SERVICE_ACCOUNT_PATH=
