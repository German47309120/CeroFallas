# Copia este archivo como .env.local únicamente después de registrar la app web.
# No pegues cuentas de servicio, contraseñas ni credenciales de SAP.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# true durante el prototipo local sin proyecto Firebase.
VITE_DEMO_MODE=true

# Cambiar a true solamente al ejecutar los emuladores locales.
VITE_USE_FIREBASE_EMULATORS=false

# true únicamente cuando las Functions administrativas estén desplegadas.
VITE_ADMIN_FUNCTIONS_ENABLED=false

# Enlace HTTPS autorizado de Power BI. Admite vista con autenticación o publicación aprobada.
VITE_POWER_BI_REPORT_URL=

# Clave pública registrada para esta app web en App Check / reCAPTCHA Enterprise.
# Dejar vacía hasta completar el registro y revisar métricas antes de aplicar enforcement.
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=
